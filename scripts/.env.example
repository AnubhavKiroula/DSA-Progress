# LeetCode credentials
# ----------------------
# Copy this file to .env (in the repo root) and fill in your values.
# NEVER commit .env to git — it's already in .gitignore.

# Your LeetCode session cookie.
# Get it from: Browser DevTools → Application → Cookies → leetcode.com → LEETCODE_SESSION
LEETCODE_SESSION=your_leetcode_session_cookie_here

# Your LeetCode username (used for display / profile URL)
LEETCODE_USERNAME=AnubhavKiroula

# Output directory for problem folders (default: problems/)
PROBLEMS_DIR=problems
